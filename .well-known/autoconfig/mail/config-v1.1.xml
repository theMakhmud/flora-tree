<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
    <emailProvider id="floratreeservices.com.au">
        <domain>floratreeservices.com.au</domain>
        <displayName>info</displayName>
        <displayShortName>info</displayShortName>

        <incomingServer type="imap">
            <hostname>mail.floratreeservices.com.au</hostname>
            <port>993</port>
            <socketType>SSL</socketType>
            <authentication>password-cleartext</authentication>
            <username>%EMAILADDRESS%</username>
        </incomingServer>

        <outgoingServer type="smtp">
            <hostname>mail.floratreeservices.com.au</hostname>
            <port>465</port>
            <socketType>SSL</socketType>
            <authentication>password-cleartext</authentication>
            <username>%EMAILADDRESS%</username>
        </outgoingServer>
    </emailProvider>
</clientConfig>
